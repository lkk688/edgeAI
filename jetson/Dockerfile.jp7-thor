# =============================================================================
# Unified Jetson AI + Robotics container — Jetson THOR on the NGC 26.05 base
#   (JetPack 7.x, Ubuntu 24.04, Python 3.12, torch 2.12, CUDA 13.2, TensorRT 10.16)
#
# Thor variant of ./Dockerfile.jp7 (which stays the Orin/Thor 25.08 recipe). Same
# sections and build args; what differs and why:
#
#   * BASE nvcr.io/nvidia/pytorch:26.05-py3 instead of 25.08-py3.
#     26.05 ships CUDA 13.2 but runs on the JetPack 7.1 / driver 580 (CUDA 13.0) host
#     through its bundled forward-compat libs (/usr/local/cuda/compat), verified on Thor.
#     Its TensorRT 10.16.1 + modelopt 0.43 build OpenPI's FP8+NVFP4 pi0.5 engine; the
#     25.08 base's TensorRT 10.13 hangs on it (robotics/JETSON_THOR.md §9.5).
#   * numpy stays at the base's 2.1 (25.08's torch-tensorrt forced numpy<2; 26.05's
#     does not), so lerobot / rerun get the numpy 2 they ask for.
#   * LeRobot is installed with `uv pip --override`: lerobot 0.6.x pins torch<2.12 and
#     torchvision<0.27, and PEP 440 excludes the base's 2.12.0a0 / 0.27.0a0 pre-releases
#     from those ranges; plain pip would fail or silently fall back to an ancient lerobot.
#   * OpenCV 4.13 (CUDA 13 support) built for sm_110 (Thor), GStreamer ON.
#   * llama.cpp built for CUDA arch 110.
#   * Thor-only extras on by default: Isaac ROS (9b) and the GR00T/OpenPI venvs (9c).
#   * Also builds the JetPack 7.2 Orin image (Docker Hub cmpelkk/jetson-unified:jp7-orin):
#       --build-arg OPENCV_CUDA_ARCH_BIN=8.7 --build-arg LLAMA_CUDA_ARCH=87 \
#       --build-arg INSTALL_THOR_VLA=0 --build-arg INSTALL_ISAAC_ROS=0
#     The 26.05 torch (sm_80/86/...) runs on Orin (8.7), verified on a JetPack 7.2 Orin Nano.
#     sjsujetsontool v2 pulls :jp7-thor on Thor and :jp7-orin on Orin (--jp7).
# =============================================================================
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.05-py3
FROM ${BASE_IMAGE}

LABEL maintainer="kaikai.liu@sjsu.edu"
LABEL org.opencontainers.image.title="cmpelkk/jetson-unified"
LABEL org.opencontainers.image.description="Unified Jetson AI+robotics+LLM container for Jetson Thor (JP7, NGC 26.05 base)"
LABEL org.opencontainers.image.source="https://github.com/lkk688/edgeAI/blob/main/jetson/Dockerfile.jp7-thor"

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:/usr/local/bin:$PATH"
ENV LD_LIBRARY_PATH="/opt/hpcx/ucx/lib:/opt/hpcx/ucc/lib:$LD_LIBRARY_PATH"
# Jetson unified memory: reduce fragmentation/OOM for big models
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Pretty pip progress in non-TTY builds
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Ports:
#  3000=Next.js Agent Lab UI    8001=generic FastAPI       8765/8766=SO-ARM101 teleop
#  8002=Agent FastAPI sidecar   8080=llama.cpp server      8888=JupyterLab
#  11434=Ollama
EXPOSE 3000 8001 8002 8080 8765 8766 8888 11434

# ============================================================================
# 1. System deps  (apt — small, stable layer that caches well)
# ============================================================================
# Block A — build/dev tools + python venv (existing)
# Block B — GStreamer stack (NEW): runtime + dev so OpenCV can link against it.
#           The NV plugins (libgstnv*.so) are NOT installed here — they are
#           bind-mounted in by --runtime nvidia at start via drivers.csv.
# Block C — FFmpeg dev + V4L runtime (NEW): video file I/O + V4L2 ioctls.
# Block D — display/X11 (NEW): so cv2.imshow works under SSH -X or VNC.
# Block E — Node.js 20 (NEW): bakes in the Next.js Agent Lab dependency so
#           `sjsujetsontool node` doesn't have to apt-install at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git cmake ninja-build pkg-config curl wget ca-certificates gnupg zstd \
      python3-venv python-is-python3 \
      libusb-1.0-0 libgl1 libglib2.0-0 v4l-utils \
      \
      libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
      libgstreamer-plugins-bad1.0-0 libgstreamer-plugins-good1.0-0 \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
      gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
      \
      ffmpeg libavcodec-dev libavformat-dev libswscale-dev libavutil-dev \
      libavfilter-dev libavdevice-dev libv4l-dev \
      \
      libgtk-3-0 libxcb-xinerama0 libxkbcommon-x11-0 x11-apps xauth \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

RUN pip install --upgrade pip

# ============================================================================
# 2. Pin the base's CUDA torch/torchvision  (critical — see comment)
# ============================================================================
# Generated FROM the base image itself. Every subsequent pip install honors
# this constraint, so no transitive dep can swap the CUDA torch wheel for a
# PyPI CPU wheel. If a package later demands newer torch than the base ships,
# the build FAILS LOUDLY here — bump BASE_IMAGE, do not ship a CPU image.
# numpy is pinned too: the base's torch / torch-tensorrt / cv2 wheels are built against it,
# and lerobot accepts anything in [2.0, 2.3). /opt/torch-overrides.txt holds torch and
# torchvision only, for `uv pip --override` where a package's own torch bound must be ignored.
RUN python -c "import torch,torchvision,numpy; \
tv='torch==%s\ntorchvision==%s\n' % (torch.__version__.split('+')[0], torchvision.__version__.split('+')[0]); \
open('/opt/torch-overrides.txt','w').write(tv); \
open('/opt/torch-constraints.txt','w').write(tv + 'numpy==%s\n' % numpy.__version__)" \
 && echo "== torch constraints ==" && cat /opt/torch-constraints.txt \
 && pip install uv
ENV PIP_CONSTRAINT=/opt/torch-constraints.txt

# ============================================================================
# 3. ML / NLP / LLM Python stack  (matches cmpelkk/jetson-llm + extras)
# ============================================================================
RUN pip install \
      numpy pandas matplotlib scipy scikit-learn tqdm tabulate requests \
      huggingface_hub transformers sentence-transformers accelerate datasets \
      langchain peft bitsandbytes optimum \
      fastapi uvicorn[standard] httpx sse-starlette pydantic \
      jupyterlab ipywidgets jupyter-server-proxy \
      gradio gradio-client \
      soundfile librosa "av>=12"

# ============================================================================
# 4. Vision: Ultralytics YOLO + COCO tooling
# ============================================================================
RUN pip install ultralytics pycocotools

# ============================================================================
# 5. Robotics: LeRobot (+Feetech servos) + Intel RealSense + gamepad
# ============================================================================
# lerobot 0.6.x declares torch<2.12, torchvision<0.27; the base ships 2.12.0a0 / 0.27.0a0,
# which PEP 440 keeps OUT of those ranges. --override replaces lerobot's torch bounds with
# the base's exact versions, so lerobot 0.6 installs on top of the CUDA torch.
# pyrealsense2: the first aarch64 cp312 wheel is 2.58.
RUN uv pip install --system --break-system-packages \
      --override /opt/torch-overrides.txt --constraint /opt/torch-constraints.txt \
      "lerobot[feetech]" "pyrealsense2>=2.58" pygame \
 && python -c "import lerobot, torch; print('lerobot', lerobot.__version__, 'torch', torch.__version__)"

# ============================================================================
# 6. numpy: keep the base's numpy 2.x
# ============================================================================
# 25.08's torch-tensorrt pinned numpy<2, which jp7 had to follow. 26.05's does not:
# the base ships numpy 2.1, pinned in /opt/torch-constraints.txt above, and that
# satisfies lerobot (>=2.0,<2.3) and rerun-sdk. Nothing to do here.

# ============================================================================
# 7. OpenCV rebuild — WITH_GSTREAMER=ON, WITH_FFMPEG=ON, WITH_CUDA=ON
# ============================================================================
# WHY rebuild: the pip-installed opencv-python from the base has FFMPEG=YES but
# GStreamer=NO and no CUDA. We need GStreamer so cv2 can drive the NV hardware
# pipelines (nvarguscamerasrc / nvv4l2decoder / nvvidconv) that --runtime nvidia
# auto-mounts. CUDA support also gives us cv2.cuda_GpuMat for zero-copy ops.
#
# COST: ~25-40 min on Jetson Orin (single-stage so the final image is self-contained).
# Toggle off with --build-arg REBUILD_OPENCV=0 if you just need the apt-installed
# gstreamer tools but not cv2 GStreamer support (saves ~35 min).
ARG REBUILD_OPENCV=1
ARG OPENCV_VERSION=4.13.0
# CUDA arch: Thor is sm_110 under CUDA 13 (it was sm_101 under CUDA 12.8/12.9).
ARG OPENCV_CUDA_ARCH_BIN=11.0
# CUDA 13.2 (this base) moved libcu++ to the cuda::std namespace macro; opencv_contrib
# 4.13.0's cudev/ptr2d/zip.hpp still opens _LIBCUDACXX_BEGIN_NAMESPACE_STD and fails with
# "tuple is not a template". Fixed upstream in opencv_contrib PR #4097 (zip.hpp only, +9
# lines), merged after 4.13.0; take that one file from the merge commit.
ARG OPENCV_CONTRIB_CUDA132_FIX=f2854f4f5e7b67d4e073ea002ae0174d437e2962
RUN if [ "$REBUILD_OPENCV" = "1" ]; then \
      pip uninstall -y opencv-python opencv-python-headless opencv-contrib-python || true && \
      cd /tmp && \
      curl -fsSL -o opencv.tar.gz \
        "https://github.com/opencv/opencv/archive/refs/tags/${OPENCV_VERSION}.tar.gz" && \
      curl -fsSL -o opencv_contrib.tar.gz \
        "https://github.com/opencv/opencv_contrib/archive/refs/tags/${OPENCV_VERSION}.tar.gz" && \
      tar xzf opencv.tar.gz && tar xzf opencv_contrib.tar.gz && \
      curl -fsSL -o opencv_contrib-${OPENCV_VERSION}/modules/cudev/include/opencv2/cudev/ptr2d/zip.hpp \
        "https://raw.githubusercontent.com/opencv/opencv_contrib/${OPENCV_CONTRIB_CUDA132_FIX}/modules/cudev/include/opencv2/cudev/ptr2d/zip.hpp" && \
      cd opencv-${OPENCV_VERSION} && mkdir build && cd build && \
      cmake -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_STANDARD=17 \
        -DCUDA_NVCC_FLAGS="-DCCCL_IGNORE_DEPRECATED_CPP_DIALECT" \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib-${OPENCV_VERSION}/modules \
        -DWITH_GSTREAMER=ON \
        -DWITH_FFMPEG=ON \
        -DWITH_V4L=ON -DWITH_LIBV4L=ON \
        -DWITH_CUDA=ON -DCUDA_ARCH_BIN=${OPENCV_CUDA_ARCH_BIN} \
        -DWITH_NPP=OFF \
        -DENABLE_FAST_MATH=ON -DCUDA_FAST_MATH=ON \
        -DWITH_CUBLAS=ON -DWITH_CUDNN=ON -DOPENCV_DNN_CUDA=ON \
        -DWITH_GTK=OFF -DWITH_QT=OFF \
        -DBUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_DOCS=OFF \
        -DBUILD_opencv_python3=ON \
        -DPYTHON3_EXECUTABLE=$(which python3) \
        -DOPENCV_PYTHON3_INSTALL_PATH=$(python3 -c "import sysconfig; print(sysconfig.get_paths()['purelib'])") \
        -DOPENCV_GENERATE_PKGCONFIG=ON \
        .. && \
      ninja -j"$(nproc)" && ninja install && ldconfig && \
      cd / && rm -rf /tmp/opencv-${OPENCV_VERSION} /tmp/opencv_contrib-${OPENCV_VERSION} \
                     /tmp/opencv.tar.gz /tmp/opencv_contrib.tar.gz ; \
    fi

# ============================================================================
# 8. llama.cpp + Ollama  (default — used by `sjsujetsontool llama` / `chat --local`)
# ============================================================================
# Was --build-arg INSTALL_LLAMACPP=1 in the old jp7 file; now DEFAULT to match
# the deployed cmpelkk/jetson-llm image. Toggle off with --build-arg INSTALL_LLAMACPP=0.
ARG INSTALL_LLAMACPP=1
# 110 = Thor (CUDA 13). For a JetPack 7.2 Orin build pass --build-arg LLAMA_CUDA_ARCH=87.
ARG LLAMA_CUDA_ARCH=110
RUN if [ "$INSTALL_LLAMACPP" = "1" ]; then \
      git clone --depth=1 https://github.com/ggerganov/llama.cpp.git /opt/llama.cpp && \
      cmake -S /opt/llama.cpp -B /opt/llama.cpp/build -DGGML_CUDA=ON -DGGML_NATIVE=OFF -DCMAKE_CUDA_ARCHITECTURES=${LLAMA_CUDA_ARCH} && \
      cmake --build /opt/llama.cpp/build --config Release -j"$(nproc)" && \
      ln -sf /opt/llama.cpp/build/bin/llama-cli   /usr/local/bin/llama-cli && \
      ln -sf /opt/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server && \
      CMAKE_ARGS="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=${LLAMA_CUDA_ARCH}" pip install --no-cache-dir llama-cpp-python && \
      curl -fsSL https://ollama.com/install.sh | sh ; \
    fi

# ============================================================================
# 9. OPTIONAL: ROS 2 Jazzy (Ubuntu 24.04)  — adds ~1.5 GB
# ============================================================================
ARG INSTALL_ROS=0
ARG INSTALL_ISAAC_ROS=1
RUN if [ "$INSTALL_ROS" = "1" ] || [ "$INSTALL_ISAAC_ROS" = "1" ]; then \
      curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
           -o /usr/share/keyrings/ros-archive-keyring.gpg && \
      echo "deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main" \
           > /etc/apt/sources.list.d/ros2.list && \
      apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-base ros-jazzy-vision-msgs ros-jazzy-cv-bridge ros-jazzy-image-publisher \
        python3-colcon-common-extensions python3-rosdep python3-vcstool git-lfs && \
      rm -rf /var/lib/apt/lists/* && \
      echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc ; \
    fi

# ============================================================================
# 9b. OPTIONAL: NVIDIA Isaac ROS Stack (Jetson Thor exclusive)
# ============================================================================
# Default: INSTALL_ISAAC_ROS=0 (keeps image small & fast for Orin Nano / standard Jetsons).
# Set --build-arg INSTALL_ISAAC_ROS=1 when building for Jetson Thor.
RUN if [ "$INSTALL_ISAAC_ROS" = "1" ]; then \
      mkdir -p /etc/ros/rosdep/sources.list.d && \
      curl -sSL https://raw.githubusercontent.com/NVIDIA-ISAAC-ROS/isaac-ros-cli/main/docker/rosdep/extra_rosdeps.yaml \
           -o /etc/ros/rosdep/sources.list.d/nvidia-isaac.yaml && \
      mkdir -p /opt/ros/isaac_ros_ws/src && cd /opt/ros/isaac_ros_ws/src && \
      git clone --depth=1 https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_common.git && \
      git clone --depth=1 https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nitros.git && \
      git clone --depth=1 https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_image_pipeline.git && \
      git clone --depth=1 https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_apriltag.git && \
      echo "source /opt/ros/isaac_ros_ws/install/setup.bash" >> /root/.bashrc ; \
    fi

# ============================================================================
# 10. Cache + workspace + default model dirs (sjsujetsontool convention)
# ============================================================================
RUN mkdir -p /models /Developer/models /root/.cache /workspace
# Mirror the env the existing image uses, so caches land on the host SSD when
# /Developer is bind-mounted in (sjsujetsontool already does this).
ENV HF_HOME=/Developer/models/huggingface \
    HF_HUB_CACHE=/Developer/models/huggingface/hub \
    LLAMA_CACHE=/Developer/models/llama_cache \
    TORCH_HOME=/Developer/models/torch
WORKDIR /workspace

# ============================================================================
# 9c. OPTIONAL: Thor VLA deployment stacks (GR00T N1.7 + OpenPI pi0.5, TensorRT)
# ============================================================================
# The Jetson AI Lab tutorials "Isaac GR00T 1.7 on Jetson Thor" and "OpenPi pi0.5 on
# Jetson Thor" each ship their own container. Their pins collide with this image
# (OpenPI: transformers 4.53.2 *patched in place*, lerobot 0.3.2, opencv 4.11;
# GR00T: torch 2.10 + TensorRT 10.15), so they are NOT installed into the system
# Python. Each gets its own venv; the system lerobot/transformers stay untouched.
#
#   /opt/gr00t-venv   self-contained (torch/TRT/modelopt from the Jetson AI Lab
#                     sbsa/cu130 index via GR00T's own install_deps.sh)
#   /opt/openpi-venv  --system-site-packages: reuses the base's torch + TensorRT +
#                     modelopt, adds OpenPI's pins on top, and receives the
#                     transformers_replace patch inside the venv only
#   /opt/src/{Isaac-GR00T,openpi}  pinned checkouts with the Jetson AI Lab patches
#
# On this 26.05 base, openpi-venv inherits torch 2.12 / TensorRT 10.16.1 / modelopt 0.43,
# i.e. the same stack as OpenPI's own openpi-pi0.5 image (which builds the FP8+NVFP4
# engine); gr00t-venv stays self-contained (torch 2.10, TRT 10.15).
#
# Default ON in this Thor file; --build-arg INSTALL_THOR_VLA=0 to skip (~10 GB).
# Usage inside the container: `source /opt/gr00t-venv/bin/activate` or
# `source /opt/openpi-venv/bin/activate`, then follow ~/Developer/robotics/JETSON_THOR.md §9.
ARG INSTALL_THOR_VLA=1
ARG GROOT_COMMIT=9c7e746b2cd37a810070a98ef41d290a07e806c2
ARG OPENPI_COMMIT=15a9616a00943ada6c20a0f158e3adb39df2ccac
RUN if [ "$INSTALL_THOR_VLA" = "1" ]; then \
      set -eux; \
      unset PIP_CONSTRAINT; \
      apt-get update && apt-get install -y --no-install-recommends git-lfs && git lfs install && \
      rm -rf /var/lib/apt/lists/*; \
      command -v uv || curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh; \
      mkdir -p /opt/src; \
      git clone https://github.com/NVIDIA/Isaac-GR00T.git /opt/src/Isaac-GR00T; \
      cd /opt/src/Isaac-GR00T && git checkout "$GROOT_COMMIT" && git lfs pull; \
      curl -fsSL https://www.jetson-ai-lab.com/code-samples/groot_n17_on_thor/download.sh | bash; \
      UV_PROJECT_ENVIRONMENT=/opt/gr00t-venv bash scripts/deployment/thor/install_deps.sh; \
      uv pip install --python /opt/gr00t-venv/bin/python "nvidia-modelopt[onnx]==0.39.0"; \
      # The base exports its own torch 2.8 lib dir in LD_LIBRARY_PATH, so the venv's torch 2.10
      # would load the base's libtorch_python (AttributeError: torch._C ... _dlpack_exchange_api).
      # activate puts the venv's torch/nvidia libs first and drops the base torch dirs.
      printf '%s\n' '' '# --- Dockerfile.jp7 9c: use this venv torch libs, not the base image torch ---' \
        'SP=/opt/gr00t-venv/lib/python3.12/site-packages' \
        '_GR00T_OLD_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"' \
        'LD_LIBRARY_PATH="$SP/torch/lib:$SP/nvidia/cu13/lib:$SP/nvidia/cudss/lib:$SP/nvidia/cudnn/lib:$(echo "$LD_LIBRARY_PATH" | tr ":" "\n" | grep -v -e dist-packages/torch -e dist-packages/torch_tensorrt | paste -sd:)"' \
        'export LD_LIBRARY_PATH TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas TRITON_PTXAS_BLACKWELL_PATH=/usr/local/cuda/bin/ptxas' \
        '# deactivate must restore LD_LIBRARY_PATH too, or the system torch then loads this venv libs' \
        'eval "$(declare -f deactivate | sed "1s/^deactivate/_gr00t_orig_deactivate/")"' \
        'deactivate () { LD_LIBRARY_PATH="$_GR00T_OLD_LD_LIBRARY_PATH"; export LD_LIBRARY_PATH; unset _GR00T_OLD_LD_LIBRARY_PATH; _gr00t_orig_deactivate "$@"; }' \
        >> /opt/gr00t-venv/bin/activate; \
      git clone --recurse-submodules https://github.com/Physical-Intelligence/openpi.git /opt/src/openpi; \
      cd /opt/src/openpi && git checkout "$OPENPI_COMMIT" && git submodule update --init --recursive; \
      curl -fsSL https://www.jetson-ai-lab.com/code-samples/openpi_on_thor/download.sh | bash; \
      python -m venv --system-site-packages /opt/openpi-venv; \
      /opt/openpi-venv/bin/pip install --no-cache-dir -U pip; \
      PIP_INDEX_URL=https://pypi.jetson-ai-lab.io/sbsa/cu130 PIP_TRUSTED_HOST=pypi.jetson-ai-lab.io \
        /opt/openpi-venv/bin/pip install --no-cache-dir --ignore-installed --no-deps PyYAML==6.0.2; \
      # The index only carries diffusers 0.36.0.dev0 (OpenPI's thor pin); lerobot 0.3.2 asks for
      # diffusers>=0.27.2 and pip will not pick a pre-release for that unless it is already installed.
      PIP_INDEX_URL=https://pypi.jetson-ai-lab.io/sbsa/cu130 PIP_TRUSTED_HOST=pypi.jetson-ai-lab.io \
        /opt/openpi-venv/bin/pip install --no-cache-dir diffusers==0.36.0.dev0; \
      cd /opt/src/openpi/deployment_scripts && \
      PIP_INDEX_URL=https://pypi.jetson-ai-lab.io/sbsa/cu130 PIP_TRUSTED_HOST=pypi.jetson-ai-lab.io \
        /opt/openpi-venv/bin/pip install --no-cache-dir -e '.[thor]' onnxslim lief; \
      cp -r /opt/src/openpi/src/openpi/models_pytorch/transformers_replace/* \
        /opt/openpi-venv/lib/python3.12/site-packages/transformers/; \
      bash -c ". /opt/gr00t-venv/bin/activate && python -c \"import torch, tensorrt; print('gr00t-venv', torch.__version__, tensorrt.__version__)\""; \
      /opt/openpi-venv/bin/python -c "import torch, tensorrt, transformers, lerobot; print('openpi-venv', torch.__version__, tensorrt.__version__, transformers.__version__, lerobot.__version__)"; \
      python -c "import transformers, lerobot; print('system', transformers.__version__, lerobot.__version__)"; \
    fi

# ============================================================================
# 11. Build-time sanity check
# ============================================================================
# docker build has no GPU, so we verify:
#   - torch is a CUDA *build* (cuda.is_available() needs --runtime nvidia at run-time)
#   - cv2 has the right backends after the rebuild  (GStreamer YES when REBUILD_OPENCV=1)
# CI / classroom build will fail loudly here on regressions.
RUN python - <<'PY'
import torch, torchvision, numpy, cv2, ultralytics, lerobot, transformers, fastapi, tensorrt
assert torch.version.cuda and '+cpu' not in torch.__version__, \
    'torch is not a CUDA build — bump BASE_IMAGE'
info = cv2.getBuildInformation()
gst   = next((l for l in info.splitlines() if 'GStreamer' in l), '')
ffm   = next((l for l in info.splitlines() if 'FFMPEG'    in l), '')
print('OK | torch',        torch.__version__,
      '| tv',              torchvision.__version__,
      '| cuda',            torch.version.cuda,
      '| numpy',           numpy.__version__,
      '| cv2',             cv2.__version__,
      '| ultralytics',     ultralytics.__version__,
      '| lerobot',         lerobot.__version__,
      '| transformers',    transformers.__version__,
      '| tensorrt',        tensorrt.__version__)
print('cv2 backends:', gst.strip(), '|', ffm.strip())
PY

# =============================================================================
# Build (on the Thor, from the repo's jetson/ dir; the Dockerfile COPYs nothing, so any
# small directory works as the context):
#
#   docker build -f Dockerfile.jp7-thor -t cmpelkk/jetson-unified:jp7-thor-2605 .
#
#   # without the GR00T/OpenPI venvs, or without the OpenCV rebuild:
#   docker build -f Dockerfile.jp7-thor --build-arg INSTALL_THOR_VLA=0 --build-arg REBUILD_OPENCV=0 \
#     -t cmpelkk/jetson-unified:jp7-thor-2605-mini .
#
# Run — the --runtime nvidia flag is REQUIRED for GStreamer NV plugins / CUDA:
#
#   docker run --rm -it --runtime nvidia --network host --ipc=host \
